@page
@using Acme.Admin.Permissions
@using Microsoft.AspNetCore.Authorization
@model Acme.Admin.Web.Pages.Newspapers.IndexModel
@inject IAuthorizationService Authorization
@section scripts
{
    <abp-script src="/Pages/Newspapers/Index.js" />
}
<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>Newspapers</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (await Authorization.IsGrantedAsync(AdminPermissions.Newspapers.Create))
                {
                    <abp-button id="NewNewspaperButton" text="New newspaper" icon="plus" button-type="Primary" />
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="NewspapersTable"></abp-table>
    </abp-card-body>
</abp-card> 